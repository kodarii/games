BETTER_AUTH_SECRET=replace-with-32-byte-random-aaaaaaaaaa
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
UPLOADTHING_TOKEN=
# IGDB metadata feature — optional. When IGDB_CLIENT_ID / IGDB_CLIENT_SECRET
# are missing or empty the feature is disabled at boot (search/enrich endpoints
# return 503, frontend falls back to manual entry). Get credentials from
# https://dev.twitch.tv/console/apps — IGDB uses Twitch OAuth.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_TIMEOUT_MS=5000
IGDB_CACHE_TTL_DAYS=30
