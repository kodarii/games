BETTER_AUTH_SECRET=replace-with-32-byte-random-aaaaaaaaaa
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
UPLOADTHING_TOKEN=
# IGDB credentials are NO LONGER read from env. They live in the
# `integration_credentials` table and are configured via the Settings UI
# (PUT /api/integrations/igdb). Existing deploys must re-enter credentials
# after upgrading — the previous one-time-seed env path has been removed.
# Only the runtime knobs below remain in env.
IGDB_TIMEOUT_MS=5000
IGDB_CACHE_TTL_DAYS=30
