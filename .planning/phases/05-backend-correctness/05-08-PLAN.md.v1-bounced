    Step 4 (Test 7, Q-DDD-1 UPDATE branch pin):
      ```ts
      it('Q-DDD-1: applyMerge UPDATE branch persists 5 Q8 fields on row pre-existence (snapshot-replay overwrites NULLs)', async () => {
        // Seed: existing row for TEST_USER_A with the 5 fields = NULL (pre-Q8 silently-dropped state)
        await db.insert(games).values({
          id: 'seed-update-target',
          userId: TEST_USER_A,
          kind: 'owned',
          externalId: 'q8-update-target',
          title: 'Pre-Q8 Game',
          developer: null,
          genre: 'Action',
          releaseYear: 2023,
          platform: 'PC',
          edition: null,
          hoursPlayed: null,
          status: 'Backlog',
          format: 'digital',
          coverColor: null,
          coverImage: null,
          price: null,
          purchasedAt: null,
          notes: null,
          metadataProvider: null,
          metadataProviderId: null,
          metadataMatchedAt: null,
          createdAt: new Date('2025-01-01'),
          updatedAt: new Date('2025-01-01'),
        });

        // ImportPlan with SAME externalId carrying the 5 fields POPULATED → hits UPDATE branch
        const newGame = NewGame.create({
          externalId: 'q8-update-target',
          kind: 'owned',
          userId: TEST_USER_A,
          title: 'Re-imported Game',
          developer: null,
          genre: 'Action',
          releaseYear: 2023,
          platform: 'PC',
          edition: null,
          hoursPlayed: null,
          status: 'Backlog',
          format: 'digital',
          coverColor: null,
          coverImage: 'https://new.example/c.jpg',
          price: 29.99,
          purchasedAt: new Date('2026-02-01'),
          notes: 're-imported',
          metadataRef: { providerName: 'igdb', providerId: '7' },
        }).value;

        const plan: ImportPlan = { platforms: [], games: [newGame] };
        await repo.apply(TEST_USER_A, plan, 'merge');

        const [row] = await db
          .select()
          .from(games)
          .where(and(eq(games.userId, TEST_USER_A), eq(games.externalId, 'q8-update-target')));

        expect(row.coverImage).toBe('https://new.example/c.jpg');
        expect(row.price).toBe(29.99);
        expect(row.purchasedAt).not.toBeNull();
        expect(row.notes).toBe('re-imported');
        expect(row.metadataProvider).toBe('igdb');
        expect(row.metadataProviderId).toBe('7');
        expect(row.metadataMatchedAt).not.toBeNull();
      });
      ```
      **Why this test fails RED on half-fix:** if Task 1 fixes INSERT only (shared `values` block unchanged for UPDATE), this test passes UPDATE on a row with `existing=true`, the UPDATE branch uses the old block, the 5 fields stay NULL/old, assertions fail. Green only when UPDATE branch uses `set(updateSet)` per Task 1 Step 2.

