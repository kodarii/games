    Step 3: Test 1 body (production-path round-trip via ImportData.execute):
      ```ts
      // (a) Seed 3 games + 2 platforms for TEST_USER_A. Populate price/purchasedAt/notes
      //     (v4-carried Q8 fields) AND coverImage/metadata cols (used for negative-assertion only).
      // ... seed via direct db.insert with explicit values

      // (b) Build snapshot1 via the REAL export use-case
      const snapshot1 = await exportSnapshot(TEST_USER_A);

      // (c) Document export-side drops (F-08-1): v4 does not carry coverImage / metadata cols
      expect(snapshot1.games[0]).not.toHaveProperty('coverImage');
      expect(snapshot1.games[0]).not.toHaveProperty('metadataProvider');
      expect(snapshot1.games[0]).not.toHaveProperty('metadataProviderId');
      expect(snapshot1.games[0]).not.toHaveProperty('metadataMatchedAt');
      // Sanity: v4 DOES carry the 3 Q8 fields we're round-tripping
      expect(snapshot1.games[0]).toHaveProperty('price');
      expect(snapshot1.games[0]).toHaveProperty('purchasedAt');
      expect(snapshot1.games[0]).toHaveProperty('notes');

      // (d) Wipe user data
      await db.delete(games).where(eq(games.userId, TEST_USER_A));
      await db.delete(platforms).where(eq(platforms.userId, TEST_USER_A));

      // (e) Apply through the REAL production path — NOT direct repo.apply (F-08-3)
      await importData.execute({ snapshot: snapshot1, mode: 'replace', userId: TEST_USER_A });

      // (f) Re-export
      const snapshot2 = await exportSnapshot(TEST_USER_A);

      // (g) Diff modulo auto-managed columns
      const stripVolatile = (snap) => ({
        ...snap,
        games: snap.games.map(({ id, createdAt, updatedAt, ...rest }) => rest),
        platforms: snap.platforms.map(({ id, createdAt, updatedAt, ...rest }) => rest),
      });
      expect(stripVolatile(snapshot2)).toEqual(stripVolatile(snapshot1));
      ```

    Step 4: Test 2 (merge idempotency via real ImportData):
      ```ts
      // Seed empty TEST_USER_C (auth row only).
      await importData.execute({ snapshot: snapshot1, mode: 'merge', userId: TEST_USER_C });
      const countAfter1 = await db.$count(games, eq(games.userId, TEST_USER_C));

      await importData.execute({ snapshot: snapshot1, mode: 'merge', userId: TEST_USER_C });
      const countAfter2 = await db.$count(games, eq(games.userId, TEST_USER_C));

      expect(countAfter2).toBe(countAfter1);  // no duplicates
      ```

    Step 5: Test 3 (F-08-6 per-user isolation pin):
      ```ts
